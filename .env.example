# ===========================================
# ENV SETUP: Copy to .env (web: apps/web/.env, API: set in Lambda/console)
# ===========================================
# WEB ENVIRONMENT (apps/web/.env or Amplify env vars)
VITE_API_URL=http://localhost:3001
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXX
# AppSync GraphQL (optional – when set, Discover/Matches/Chat use GraphQL + real-time)
VITE_APPSYNC_GRAPHQL_URL=https://xxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql
VITE_APPSYNC_REGION=us-east-1
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es,ru,hi,zh
VITE_PUBLIC_SITE_URL=https://gettrainmate.com
VITE_GA_MEASUREMENT_ID=G-C29M8NWNY4
# VITE_GSC_VERIFICATION=
# VITE_THEME_COLOR=#070b1a

# API ENVIRONMENT (.NET Lambda local)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_REGION=us-east-1
DYNAMODB_TABLE_USERS=gettrainmate-users-dev
DYNAMODB_TABLE_PROFILES=gettrainmate-profiles-dev
DYNAMODB_TABLE_MATCHES=gettrainmate-matches-dev
DYNAMODB_TABLE_MESSAGES=gettrainmate-messages-dev
DYNAMODB_TABLE_EVENTS=gettrainmate-events-dev
DYNAMODB_TABLE_CONTENT=gettrainmate-content-dev
DYNAMODB_TABLE_TRANSLATIONS=gettrainmate-translations-dev
DYNAMODB_TABLE_ENTITLEMENTS=gettrainmate-entitlements-dev
DYNAMODB_TABLE_LEADS=gettrainmate-leads-dev
DYNAMODB_TABLE_AUDIT_LOG=gettrainmate-audit-log-dev
S3_BUCKET_MEDIA=gettrainmate-media-dev
STRIPE_SECRET_KEY=sk_test_XXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXX
SES_SENDER_EMAIL=noreply@gettrainmate.com
# Lambda: SES_FROM_EMAIL + admin notifications. Prefer SSM (loaded at cold start):
#   /gettrainmate/ses-from-email   — verified SES From address
#   /gettrainmate/ses-admin-email  — comma-separated admin inboxes (signup, purchases, contact form)
# Or env: SES_FROM_EMAIL, SES_ADMIN_EMAIL
AWS_ACCOUNT_ID=123456789012

# INFRA CDK
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ENVIRONMENT=dev
STRIPE_API_KEY=sk_test_XXXXXXXXX
