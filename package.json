{
  "name": "gettrainmate-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "GetTrainMate - Training-first partner matching SaaS",
  "keywords": [
    "training",
    "partner",
    "matching",
    "gym",
    "crossfit",
    "running",
    "hyrox"
  ],
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "infra"
  ],
  "scripts": {
    "web:dev": "cd apps/web && npm run dev",
    "web:build": "cd apps/web && npm run build",
    "web:preview": "cd apps/web && npm run preview",
    "web:lint": "cd apps/web && npm run lint",
    "infra:synth": "cd infra && npm run synth",
    "infra:build": "cd infra && npm run build",
    "infra:deploy": "cd infra && npm run deploy",
    "infra:deploy-with-pool": "cd infra && npm run deploy:use-existing-pool",
    "cognito:delete-obsolete": "bash scripts/delete-obsolete-cognito-pools.sh",
    "cognito:delete-obsolete:dry": "bash scripts/delete-obsolete-cognito-pools.sh --dry-run",
    "zip": "bash scripts/build-lambda-zip.sh",
    "seed": "cd scripts && node seed.js",
    "env:sync": "node scripts/sync-env-from-aws.js",
    "env:sync-amplify": "node scripts/sync-env-from-amplify.js",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3"
  }
}
