{
  "name": "gettrainmate-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GetTrainMate - Training-first partner matching SaaS",
  "keywords": [
    "training",
    "partner",
    "matching",
    "gym",
    "crossfit",
    "running",
    "hyrox"
  ],
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "infra"
  ],
  "scripts": {
    "web:dev": "cd apps/web && npm run dev",
    "web:build": "cd apps/web && npm run build",
    "web:preview": "cd apps/web && npm run preview",
    "web:lint": "cd apps/web && npm run lint",
    "infra:synth": "cd infra && npm run synth",
    "infra:build": "cd infra && npm run build",
    "api:publish": "dotnet publish apps/api/GetTrainMate.Api.csproj -c Release -o apps/api/publish && npm run zip:publish",
    "infra:deploy": "cd infra && npm run deploy",
    "infra:deploy-with-pool": "cd infra && npm run deploy:use-existing-pool",
    "cognito:delete-obsolete": "bash scripts/delete-obsolete-cognito-pools.sh",
    "cognito:delete-obsolete:dry": "bash scripts/delete-obsolete-cognito-pools.sh --dry-run",
    "zip": "node -e \"var p=require('child_process'); p.execSync(process.platform==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/build-lambda-zip.ps1':'bash scripts/build-lambda-zip.sh',{stdio:'inherit',cwd:process.cwd()})\"",
    "zip:publish": "node -e \"var p=require('child_process'); p.execSync(process.platform==='win32'?'powershell -ExecutionPolicy Bypass -File scripts/zip-publish-folder.ps1':'bash scripts/zip-publish-folder.sh',{stdio:'inherit',cwd:process.cwd()})\"",
    "deploy:full": "powershell -ExecutionPolicy Bypass -File scripts/full-deploy.ps1",
    "deploy:push-zip": "powershell -ExecutionPolicy Bypass -File scripts/full-deploy.ps1 -SkipTests -AutoCommit",
    "seed": "cd scripts && node seed.js",
    "env:sync": "node scripts/sync-env-from-aws.js",
    "env:sync-amplify": "node scripts/sync-env-from-amplify.js",
    "growth:install": "npm i --prefix scripts/growth --ignore-scripts",
    "growth:snapshot": "node scripts/growth/collect-funnel-snapshot.mjs",
    "growth:health": "node scripts/growth/check-production-health.mjs",
    "growth:verify-secrets": "node scripts/growth/verify-secrets.mjs",
    "growth:email": "node scripts/growth/compose-and-send-growth-email.mjs",
    "growth:test": "node --test scripts/growth/tests/*.test.mjs",
    "growth:outreach:preview": "node scripts/growth/outreach.mjs preview",
    "growth:outreach:validate": "node scripts/growth/outreach.mjs validate",
    "growth:outreach:send": "node scripts/growth/outreach.mjs send",
    "growth:discovery:run": "node scripts/growth/run-market-discovery.mjs",
    "growth:discovery:report": "node scripts/growth/discovery-acquisition-report.mjs",
    "growth:instagram:publish": "node scripts/growth/publish-approved-instagram.mjs",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3"
  }
}
