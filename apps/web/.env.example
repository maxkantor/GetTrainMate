# Copy to .env and fill in values for local development
# Get VITE_COGNITO_* from: npm run infra:deploy (see outputs) or AWS Cognito Console
#
# If login works on Amplify but not localhost: use the SAME values as Amplify.
# In Amplify Console → App → Environment variables, copy VITE_COGNITO_USER_POOL_ID,
# VITE_COGNITO_CLIENT_ID, VITE_COGNITO_REGION into this file.

VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXX
VITE_COGNITO_REGION=us-east-1

# Optional: API URL for proxied /api requests (default: http://localhost:3001)
# VITE_API_URL=http://localhost:3001

# Optional: AppSync GraphQL for Discover/Matches/Chat
# VITE_APPSYNC_GRAPHQL_URL=https://xxx.appsync-api.us-east-1.amazonaws.com/graphql
# VITE_APPSYNC_REGION=us-east-1
